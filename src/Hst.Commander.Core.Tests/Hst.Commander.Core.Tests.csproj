<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
        <PackageReference Include="xunit" Version="2.5.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
      <None Update="TestData\Volumes\Local\Dir1\file3.txt">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="TestData\Volumes\Local\file1.txt">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="TestData\Volumes\Local\file2.txt">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="TestData\Archives\*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <!-- like the .NET notices embedded in self-contained apps by Directory.Build.targets (see GivenLicenses) -->
      <EmbeddedResource Include="TestData\dotnet-notices.txt" LogicalName="THIRD-PARTY-NOTICES-DOTNET.txt" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Hst.Commander.Core\Hst.Commander.Core.csproj" />
      <ProjectReference Include="..\Hst.Commander.Abstractions\Hst.Commander.Abstractions.csproj" />
      <ProjectReference Include="..\Hst.Commander.Plugins.Smb\Hst.Commander.Plugins.Smb.csproj" />
    </ItemGroup>

</Project>

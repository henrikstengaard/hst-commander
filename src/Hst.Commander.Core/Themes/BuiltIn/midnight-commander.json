{
  "$schema": "https://raw.githubusercontent.com/henrikstengaard/hst-commander/main/docs/theme.schema.json",
  "id": "MidnightCommander",
  "name": "Midnight Commander",
  "dark": {
    "systemChrome": true,
    "palette": {
      "neutral": "#0000AA",
      "ink": "#FFFFFF",
      "primary": "#AAAAAA",
      "accent": "#FFFF55",
      "success": "#55FF55",
      "warning": "#FFFF55",
      "error": "#FF5555",
      "info": "#55FFFF"
    },
    "overrides": {
      "pane-background": "#0000AA",
      "pane-border": "#FFFFFF",
      "header": "#FFFF55",
      "container": "#FFFFFF",
      "item": "#AAAAAA",
      "executable": "#55FF55",
      "path": "#FFFF55",
      "active-path-background": "#AAAAAA",
      "active-path-foreground": "#000000",
      "cursor-background": "#AAAAAA",
      "cursor-foreground": "#000000",
      "marked": "#FFFF55",
      "viewer-selection-background": "#00AAAA",
      "viewer-selection-foreground": "#000000",
      "tui-pane-background": "#0037DA",
      "tui-pane-border": "#F2F2F2",
      "tui-header": "#F9F1A5",
      "tui-container": "#F2F2F2",
      "tui-item": "#CCCCCC",
      "tui-executable": "#16C60C",
      "tui-marked": "#F9F1A5",
      "tui-path": "#F9F1A5",
      "tui-cursor-foreground": "#0C0C0C",
      "tui-cursor-background": "#CCCCCC",
      "tui-marked-cursor-foreground": "#F9F1A5",
      "tui-active-path-foreground": "#0C0C0C",
      "tui-active-path-background": "#CCCCCC",
      "tui-menu-foreground": "#0C0C0C",
      "tui-menu-background": "#3A96DD",
      "tui-button-foreground": "#0C0C0C",
      "tui-button-background": "#3A96DD",
      "tui-menu-focus-foreground": "#F2F2F2",
      "tui-menu-focus-background": "#0C0C0C",
      "tui-menu-hot-foreground": "#F9F1A5",
      "tui-key-foreground": "#F2F2F2",
      "tui-key-background": "#0C0C0C",
      "tui-dialog-foreground": "#0C0C0C",
      "tui-dialog-background": "#CCCCCC",
      "tui-dialog-focus-foreground": "#0C0C0C",
      "tui-dialog-focus-background": "#61D6D6"
    }
  }

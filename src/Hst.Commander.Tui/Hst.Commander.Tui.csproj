<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationIcon>..\icon\hst-commander.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Terminal.Gui" Version="2.0.0-prealpha.1895" />
      <!-- Terminal.Gui depends on Microsoft.SourceLink.GitHub 8.0.0, whose Microsoft.Build.Tasks.Git 8.0.0
           has a known vulnerability (GHSA-23fw-v26w-5fgq); override it with a fixed build-only version -->
      <PackageReference Include="Microsoft.Build.Tasks.Git" Version="10.0.402" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Hst.Commander.Core\Hst.Commander.Core.csproj" />
      <ProjectReference Include="..\Hst.Commander.Abstractions\Hst.Commander.Abstractions.csproj" />
    </ItemGroup>

</Project>

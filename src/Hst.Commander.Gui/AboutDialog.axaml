<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hst.Commander.Gui.AboutDialog"
        Title="About"
        SizeToContent="WidthAndHeight"
        MinWidth="300" MaxWidth="600"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock x:Name="NameAndVersionText" FontWeight="Bold" FontSize="16" />
        <TextBlock x:Name="AuthorText" TextWrapping="Wrap" />
        <Button x:Name="OkButton" Content="OK" HorizontalAlignment="Center" MinWidth="80" Margin="0,8,0,0"
                HorizontalContentAlignment="Center" IsDefault="True" IsCancel="True" />
    </StackPanel>
</Window>

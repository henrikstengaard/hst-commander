<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hst.Commander.Gui.SettingsDialog"
        Title="Settings"
        Width="400" Height="200"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="OkButton" Content="OK" MinWidth="80" HorizontalContentAlignment="Center"
                    IsDefault="True" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="80" HorizontalContentAlignment="Center"
                    IsCancel="True" />
        </StackPanel>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" VerticalAlignment="Top">
            <TextBlock Grid.Column="0" Text="Theme:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="ThemeComboBox" Grid.Column="1" HorizontalAlignment="Stretch" />
        </Grid>
    </DockPanel>
</Window>

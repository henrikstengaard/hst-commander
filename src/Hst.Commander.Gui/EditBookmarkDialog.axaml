<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hst.Commander.Gui.EditBookmarkDialog"
        Title="Edit bookmark"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="8">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="12" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Volume:" VerticalAlignment="Center" />
            <TextBlock x:Name="VolumeText" Grid.Row="0" Grid.Column="1" Opacity="0.7" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" VerticalAlignment="Center" />
            <TextBox x:Name="DescriptionTextBox" Grid.Row="1" Grid.Column="1" />
            <TextBlock x:Name="LocationLabel" Grid.Row="2" Grid.Column="0" Text="Location:"
                       VerticalAlignment="Center" />
            <TextBox x:Name="LocationTextBox" Grid.Row="2" Grid.Column="1" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Path:" VerticalAlignment="Center" />
            <TextBox x:Name="PathTextBox" Grid.Row="3" Grid.Column="1" />
            <TextBlock x:Name="UserNameLabel" Grid.Row="4" Grid.Column="0" Text="User name:"
                       VerticalAlignment="Center" />
            <TextBox x:Name="UserNameTextBox" Grid.Row="4" Grid.Column="1" />
            <TextBlock x:Name="PasswordLabel" Grid.Row="5" Grid.Column="0" Text="Password:"
                       VerticalAlignment="Center" />
            <TextBox x:Name="PasswordTextBox" Grid.Row="5" Grid.Column="1" PasswordChar="●" />
            <CheckBox x:Name="StorePasswordCheckBox" Grid.Row="6" Grid.Column="1" />
        </Grid>
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="OkButton" Content="OK" MinWidth="80" HorizontalContentAlignment="Center"
                    IsDefault="True" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="80" HorizontalContentAlignment="Center"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

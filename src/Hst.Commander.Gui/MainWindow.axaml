<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Hst.Commander.Gui"
        x:Class="Hst.Commander.Gui.MainWindow"
        Title="Hst Commander"
        Icon="avares://Hst.Commander.Gui/Assets/hst-commander.ico"
        Width="1200" Height="750"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Classes="menuBar">
            <!-- shown at the right of the menu bar when running as administrator or root -->
            <Border x:Name="AdministratorIndicator" DockPanel.Dock="Right" IsVisible="False"
                    Background="{DynamicResource AdministratorBackground}" CornerRadius="3" Margin="4,2"
                    VerticalAlignment="Center" Padding="8,2">
                <TextBlock x:Name="AdministratorText" Foreground="{DynamicResource AdministratorForeground}"
                           FontWeight="Bold" />
            </Border>
            <Menu>
                <MenuItem Header="_File">
                    <MenuItem x:Name="ViewMenuItem" Header="Vie_w..." InputGesture="F3" />
                    <MenuItem x:Name="EditMenuItem" Header="_Edit..." InputGesture="F4" />
                    <MenuItem x:Name="CopyMenuItem" Header="_Copy..." InputGesture="F5" />
                    <MenuItem x:Name="MoveMenuItem" Header="Mo_ve/rename..." InputGesture="F6" />
                    <MenuItem x:Name="MakeDirectoryMenuItem" Header="_Make directory..." InputGesture="F7" />
                    <MenuItem x:Name="DeleteMenuItem" Header="_Delete..." InputGesture="F8" />
                    <MenuItem x:Name="CreateVolumeMenuItem" Header="Create vo_lume..." InputGesture="F9" />
                    <MenuItem x:Name="PropertiesMenuItem" Header="_Properties..." InputGesture="Alt+Enter" />
                    <MenuItem x:Name="OpenAsVolumeMenuItem" Header="Ope_n as volume" InputGesture="Ctrl+PageDown" />
                    <Separator />
                    <!-- header set by the code-behind, hidden when elevated or the GUI can't restart itself -->
                    <MenuItem x:Name="RestartElevatedMenuItem" />
                    <MenuItem x:Name="SettingsMenuItem" Header="_Settings..." />
                    <Separator />
                    <MenuItem x:Name="QuitMenuItem" Header="_Quit" InputGesture="F10" />
                </MenuItem>
                <MenuItem Header="_Mark">
                    <!-- +, - and * are matched by their symbol in MainWindow, key gestures would be shown as "OemPlus" etc. -->
                    <MenuItem x:Name="SelectAllMenuItem" Header="Select _all" InputGesture="Ctrl+A" />
                    <MenuItem x:Name="SelectGroupMenuItem" Header="Select _group... (+)" />
                    <MenuItem x:Name="UnselectGroupMenuItem" Header="_Unselect group... (-)" />
                    <MenuItem x:Name="InvertSelectionMenuItem" Header="_Invert selection (*)" />
                </MenuItem>
                <MenuItem Header="_Go">
                    <MenuItem x:Name="LeftVolumeMenuItem" Header="_Left volume..." />
                    <MenuItem x:Name="RightVolumeMenuItem" Header="_Right volume..." />
                    <MenuItem x:Name="LocationMenuItem" Header="L_ocation..." InputGesture="Ctrl+L" />
                    <MenuItem x:Name="HomeMenuItem" Header="_Home directory" InputGesture="Ctrl+H" />
                    <MenuItem x:Name="AddBookmarkMenuItem" Header="Add _bookmark..." InputGesture="Ctrl+B" />
                    <Separator />
                    <MenuItem x:Name="SameLocationMenuItem" Header="_Same location in other pane" InputGesture="Ctrl+D" />
                    <MenuItem x:Name="SwapPanesMenuItem" Header="Sw_ap panes" InputGesture="Ctrl+U" />
                    <MenuItem x:Name="RefreshMenuItem" Header="Re_fresh" InputGesture="Ctrl+R" />
                </MenuItem>
                <MenuItem Header="_Commands">
                    <MenuItem x:Name="SearchMenuItem" Header="_Search..." InputGesture="Ctrl+S" />
                    <MenuItem x:Name="QuickSearchMenuItem" Header="_Quick search" InputGesture="Ctrl+F" />
                    <MenuItem x:Name="CommandLineMenuItem" Header="Command _line" InputGesture="Ctrl+T" />
                </MenuItem>
                <!-- the navigation modes of the active pane, added by the code-behind -->
                <MenuItem x:Name="ViewMenu" Header="_View" />
                <MenuItem Header="_Help">
                    <MenuItem x:Name="AboutMenuItem" Header="_About..." />
                </MenuItem>
            </Menu>
        </DockPanel>
        <!-- bottom area with the buttons of the theme, e.g. the function key bar; the buttons aren't focusable so the
             active pane keeps the focus -->
        <local:ButtonPanelView x:Name="BottomPanel" DockPanel.Dock="Bottom" />
        <!-- the command line, like Midnight Commander's; the prompt doesn't show the directory, which the path panel
             of the active pane shows, to leave room for the command -->
        <DockPanel DockPanel.Dock="Bottom" Background="{DynamicResource PaneBackground}">
            <TextBlock x:Name="CommandPrompt" Text=">" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="6,0,4,0"
                       Foreground="{DynamicResource ItemForeground}" />
            <TextBox x:Name="CommandBox" Margin="0,2,2,2" MinHeight="0" Padding="4,2" />
        </DockPanel>
        <Grid ColumnDefinitions="*,*">
            <local:PaneView x:Name="LeftPane" Grid.Column="0" />
            <local:PaneView x:Name="RightPane" Grid.Column="1" />
        </Grid>
    </DockPanel>
</Window>

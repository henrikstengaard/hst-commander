<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Hst.Commander.Gui"
        x:Class="Hst.Commander.Gui.MainWindow"
        Title="Hst Commander"
        Icon="avares://Hst.Commander.Gui/Assets/hst-commander.ico"
        Width="1200" Height="750"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <!-- shown at the right of the menu bar when running as administrator or root -->
            <Border x:Name="AdministratorIndicator" DockPanel.Dock="Right" IsVisible="False"
                    Background="{DynamicResource AdministratorBackground}" CornerRadius="3" Margin="4,2"
                    VerticalAlignment="Center" Padding="8,2">
                <TextBlock x:Name="AdministratorText" Foreground="{DynamicResource AdministratorForeground}"
                           FontWeight="Bold" />
            </Border>
            <Menu>
                <MenuItem Header="_File">
                    <MenuItem x:Name="ViewMenuItem" Header="Vie_w..." InputGesture="F3" />
                    <MenuItem x:Name="EditMenuItem" Header="_Edit..." InputGesture="F4" />
                    <MenuItem x:Name="CopyMenuItem" Header="_Copy..." InputGesture="F5" />
                    <MenuItem x:Name="MoveMenuItem" Header="Mo_ve/rename..." InputGesture="F6" />
                    <MenuItem x:Name="MakeDirectoryMenuItem" Header="_Make directory..." InputGesture="F7" />
                    <MenuItem x:Name="DeleteMenuItem" Header="_Delete..." InputGesture="F8" />
                    <MenuItem x:Name="CreateVolumeMenuItem" Header="Cr_eate volume..." InputGesture="F9" />
                    <MenuItem x:Name="PropertiesMenuItem" Header="_Properties..." InputGesture="Alt+Enter" />
                    <MenuItem x:Name="OpenAsVolumeMenuItem" Header="Ope_n as volume" InputGesture="Ctrl+PageDown" />
                    <Separator />
                    <!-- +, - and * are matched by their symbol in MainWindow, key gestures would be shown as "OemPlus" etc. -->
                    <MenuItem x:Name="SelectGroupMenuItem" Header="Select _group... (+)" />
                    <MenuItem x:Name="UnselectGroupMenuItem" Header="_Unselect group... (-)" />
                    <MenuItem x:Name="InvertSelectionMenuItem" Header="_Invert selection (*)" />
                    <Separator />
                    <MenuItem x:Name="LeftVolumeMenuItem" Header="_Left volume..." />
                    <MenuItem x:Name="RightVolumeMenuItem" Header="_Right volume..." />
                    <MenuItem x:Name="LocationMenuItem" Header="L_ocation..." InputGesture="Ctrl+L" />
                    <Separator />
                    <MenuItem x:Name="SettingsMenuItem" Header="_Settings..." />
                    <Separator />
                    <MenuItem x:Name="QuitMenuItem" Header="_Quit" InputGesture="F10" />
                </MenuItem>
                <!-- the navigation modes of the active pane, added by the code-behind -->
                <MenuItem x:Name="ViewMenu" Header="_View" />
                <MenuItem Header="_Help">
                    <MenuItem x:Name="AboutMenuItem" Header="_About..." />
                </MenuItem>
            </Menu>
        </DockPanel>
        <!-- function key bar; the buttons aren't focusable so the active pane keeps the focus -->
        <UniformGrid DockPanel.Dock="Bottom" Rows="1">
            <UniformGrid.Styles>
                <Style Selector="Button.functionKey">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Margin" Value="1" />
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Style Selector="Button.functionKey TextBlock">
                    <Setter Property="Padding" Value="6,3" />
                </Style>
                <Style Selector="Button.functionKey TextBlock.key">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Padding" Value="6,3,0,3" />
                </Style>
            </UniformGrid.Styles>
            <Button x:Name="ViewButton" Classes="functionKey">
                <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="F3" /><TextBlock Text="View" /></StackPanel>
            </Button>
            <Button x:Name="EditButton" Classes="functionKey">
                <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="F4" /><TextBlock Text="Edit" /></StackPanel>
            </Button>
            <Button x:Name="CopyButton" Classes="functionKey">
                <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="F5" /><TextBlock Text="Copy" /></StackPanel>
            </Button>
            <Button x:Name="MoveButton" Classes="functionKey">
                <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="F6" /><TextBlock Text="Move" /></StackPanel>
            </Button>
            <Button x:Name="MkdirButton" Classes="functionKey">
                <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="F7" /><TextBlock Text="Mkdir" /></StackPanel>
            </Button>
            <Button x:Name="DeleteButton" Classes="functionKey">
                <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="F8" /><TextBlock Text="Delete" /></StackPanel>
            </Button>
            <Button x:Name="CreateButton" Classes="functionKey">
                <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="F9" /><TextBlock Text="Create" /></StackPanel>
            </Button>
            <Button x:Name="QuitButton" Classes="functionKey">
                <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="F10" /><TextBlock Text="Quit" /></StackPanel>
            </Button>
        </UniformGrid>
        <Grid ColumnDefinitions="*,*">
            <local:PaneView x:Name="LeftPane" Grid.Column="0" />
            <local:PaneView x:Name="RightPane" Grid.Column="1" />
        </Grid>
    </DockPanel>
</Window>

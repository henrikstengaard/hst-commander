<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hst.Commander.Gui.LicenseDialog"
        Width="760" Height="560"
        MinWidth="400" MinHeight="300"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <Button x:Name="CloseButton" DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Right" MinWidth="80"
                HorizontalContentAlignment="Center" Margin="0,8,0,0" IsDefault="True" IsCancel="True" />
        <TextBox x:Name="LicenseTextBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                 FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>

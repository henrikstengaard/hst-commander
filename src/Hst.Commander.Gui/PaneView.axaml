<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Hst.Commander.Gui"
             x:Class="Hst.Commander.Gui.PaneView"
             FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"
             FontSize="14">
    <UserControl.Styles>
        <Style Selector="ListBox.entries">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBox.entries Grid.row TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ItemForeground}" />
        </Style>
        <Style Selector="ListBox.entries Grid.row.container TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ContainerForeground}" />
        </Style>
        <Style Selector="ListBox.entries Grid.row.executable TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ExecutableForeground}" />
        </Style>
        <!-- the current entry is only shown in the active pane -->
        <Style Selector="ListBox.entries:not(.active) ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.entries.active ListBoxItem:selected Grid.row TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SelectedEntryForeground}" />
        </Style>
        <!-- after the current row style, so marked entries keep their color under the cursor -->
        <Style Selector="ListBox.entries Grid.row.marked TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MarkedEntryForeground}" />
        </Style>
        <Style Selector="Grid.row TextBlock, Grid.header TextBlock">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.header TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border#PathBadge">
            <Setter Property="Background" Value="{DynamicResource PaneBackground}" />
        </Style>
        <Style Selector="Border#PathBadge TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PathForeground}" />
        </Style>
        <Style Selector="Border#PathBadge.active">
            <Setter Property="Background" Value="{DynamicResource ActivePathBackground}" />
        </Style>
        <Style Selector="Border#PathBadge.active TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ActivePathForeground}" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <!-- thumbnail navigation mode: large icons with the names below, row by row -->
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="ThumbnailTemplate" x:DataType="local:EntryItem">
            <Grid Classes="row" Classes.container="{Binding IsContainer}"
                  Classes.executable="{Binding IsExecutable}"
                  Classes.marked="{Binding IsMarked}" Background="Transparent"
                  Width="112" RowDefinitions="Auto,Auto" ToolTip.Tip="{Binding DisplayName}">
                <Image Width="80" Height="80" Margin="0,6,0,2" Source="{Binding Icon}" Stretch="Uniform"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                <TextBlock Grid.Row="1" Text="{Binding DisplayName}" TextAlignment="Center" TextWrapping="Wrap"
                           MaxLines="2" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- bordered panel above the pane with the current path, highlighted when the pane is active,
             and below it the summary of the marked entries and the free/total disk space of the current drive -->
        <Border Grid.Row="0" Background="{DynamicResource PaneBackground}" BorderBrush="{DynamicResource PaneBorder}"
                BorderThickness="1" Margin="2,2,2,0" Padding="4,2">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <Border x:Name="PathBadge" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        HorizontalAlignment="Left" Padding="4,0">
                    <TextBlock x:Name="PathText" TextTrimming="PrefixCharacterEllipsis" />
                </Border>
                <TextBlock x:Name="SummaryText" Grid.Row="1" Grid.Column="0" Margin="4,0,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PathForeground}" />
                <TextBlock x:Name="DiskSpaceText" Grid.Row="1" Grid.Column="1" Margin="8,0,4,0"
                           Foreground="{DynamicResource PathForeground}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource PaneBackground}" BorderBrush="{DynamicResource PaneBorder}"
                BorderThickness="1" Margin="2">
            <Grid RowDefinitions="Auto,*">
                <!-- column dividers continue below the last entry -->
                <Grid x:Name="DividersGrid" Grid.RowSpan="2" IsHitTestVisible="False" ColumnDefinitions="*,90,150">
                    <Border Grid.Column="1" BorderBrush="{DynamicResource PaneBorder}" BorderThickness="1,0,0,0" />
                    <Border Grid.Column="2" BorderBrush="{DynamicResource PaneBorder}" BorderThickness="1,0,0,0" />
                </Grid>

                <Grid x:Name="HeaderGrid" Grid.Row="0" Classes="header" ColumnDefinitions="*,90,150">
                    <TextBlock Grid.Column="0" Text="Name" />
                    <TextBlock Grid.Column="1" Text="Size" />
                    <TextBlock Grid.Column="2" Text="Modified" />
                </Grid>

                <ListBox x:Name="EntriesList" Grid.Row="1" Classes="entries" SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:EntryItem">
                            <Grid Classes="row" Classes.container="{Binding IsContainer}"
                                  Classes.executable="{Binding IsExecutable}"
                                  Classes.marked="{Binding IsMarked}" Background="Transparent"
                                  ColumnDefinitions="*,90,150">
                                <DockPanel Grid.Column="0">
                                    <Image DockPanel.Dock="Left" Width="16" Height="16" Margin="4,0,0,0"
                                           Source="{Binding Icon}" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DockPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Size}" TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{Binding Modified}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- navigation modes of plugins: icons at positions, e.g. the Amiga Workbench -->
                <local:IconLayoutView x:Name="IconLayout" Grid.Row="0" Grid.RowSpan="2" IsVisible="False" />

                <!-- shown while listing takes long, e.g. the physical disks while a sleeping disk wakes up -->
                <Border x:Name="ListingProgress" Grid.Row="0" Grid.RowSpan="2" IsVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,10"
                        Background="{DynamicResource PaneBackground}" BorderBrush="{DynamicResource PaneBorder}"
                        BorderThickness="1" CornerRadius="4">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ListingProgressText" Foreground="{DynamicResource PathForeground}"
                                   HorizontalAlignment="Center" />
                        <ProgressBar x:Name="ListingProgressBar" IsIndeterminate="True" MinWidth="240" />
                        <!-- shown while making a temporary copy, e.g. of an image inside another image -->
                        <Button x:Name="ListingCancelButton" Content="Cancel" IsVisible="False" MinWidth="80"
                                HorizontalAlignment="Center" HorizontalContentAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- shown when icons were moved in a navigation mode of a plugin -->
        <Border x:Name="IconPositionsBar" Grid.Row="2" IsVisible="False" Background="{DynamicResource PaneBackground}"
                BorderBrush="{DynamicResource PaneBorder}" BorderThickness="1" Margin="2,0,2,2" Padding="4,2">
            <DockPanel>
                <Button x:Name="ResetPositionsButton" DockPanel.Dock="Right" Content="Reset" Margin="4,0,0,0" />
                <Button x:Name="SavePositionsButton" DockPanel.Dock="Right" Content="Save" />
                <TextBlock Text="Icon positions changed" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource PathForeground}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hst.Commander.Gui.PropertiesDialog"
        Title="Properties"
        Width="600"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="8">
        <DockPanel>
            <!-- clicking the icon views it in a higher resolution -->
            <Button x:Name="IconButton" DockPanel.Dock="Left" Margin="0,0,12,0" Padding="2" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" ToolTip.Tip="View icon" IsVisible="False">
                <Image x:Name="EntryIcon" Width="32" Height="32" />
            </Button>
            <TextBlock x:Name="NameText" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </DockPanel>
        <!-- separators and lines of the sections are added by the code-behind -->
        <Grid x:Name="LinesGrid" ColumnDefinitions="Auto,*" />
        <ProgressBar x:Name="UsedProgressBar" Minimum="0" Maximum="1" ShowProgressText="True" IsVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="OkButton" Content="OK" MinWidth="80" HorizontalContentAlignment="Center"
                    IsDefault="True" IsCancel="True" />
            <!-- shown when check boxes can be changed -->
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="80" HorizontalContentAlignment="Center"
                    IsVisible="False" />
        </StackPanel>
    </StackPanel>
</Window>

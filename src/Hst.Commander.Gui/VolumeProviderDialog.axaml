<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Hst.Commander.Core"
        x:Class="Hst.Commander.Gui.VolumeProviderDialog"
        Title="Volume"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <StackPanel Margin="16" Spacing="8">
        <ListBox x:Name="VolumeProvidersList" MaxHeight="400">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:VolumeChoice">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="OkButton" Content="OK" MinWidth="80" HorizontalContentAlignment="Center"
                    IsDefault="True" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="80" HorizontalContentAlignment="Center"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

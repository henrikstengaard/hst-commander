<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Hst.Commander.Gui"
        x:Class="Hst.Commander.Gui.ThemeChromeStyles">
    <!-- styles applied for themes coloring the window's chrome (not the built-in themes, which keep the Fluent look),
         using the brushes ThemeManager makes from the theme's colors: the menu bar, the bottom area and its buttons
         and the parent buttons -->
    <Style Selector="local|MainWindow">
        <Setter Property="Background" Value="{DynamicResource BottomBackground}" />
    </Style>
    <Style Selector="DockPanel.menuBar">
        <Setter Property="Background" Value="{DynamicResource MenuBackground}" />
    </Style>
    <Style Selector="DockPanel.menuBar > Menu > MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource MenuForeground}" />
    </Style>
    <Style Selector="local|ButtonPanelView">
        <Setter Property="Background" Value="{DynamicResource BottomBackground}" />
    </Style>
    <Style Selector="Button.panelButton, Button.parentButton">
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PaneBorder}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
</Styles>

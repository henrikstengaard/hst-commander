<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hst.Commander.Gui.MidnightCommanderStyles">
    <!-- styles only applied for the Midnight Commander theme: the current row colors of the panes.
         Other controls (menu, function key bar, dialogs) keep the Fluent styling -->
    <Style Selector="ListBox.entries ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.entries.active ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#AAAAAA" />
    </Style>
</Styles>

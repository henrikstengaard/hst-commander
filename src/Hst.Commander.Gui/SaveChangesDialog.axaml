<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="using:Hst.Commander.Gui"
        x:Class="Hst.Commander.Gui.SaveChangesDialog"
        Title="Edit"
        SizeToContent="WidthAndHeight"
        MinWidth="360" MaxWidth="600"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="16">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <gui:QuestionIcon Grid.Column="0" />
            <TextBlock Grid.Column="1" x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="SaveButton" Content="_Save" MinWidth="80" HorizontalContentAlignment="Center"
                    IsDefault="True" />
            <Button x:Name="DiscardButton" Content="_Discard" MinWidth="80" HorizontalContentAlignment="Center" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="80" HorizontalContentAlignment="Center"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

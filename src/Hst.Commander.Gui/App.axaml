<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Hst.Commander.Gui"
             x:Class="Hst.Commander.Gui.App">
    <Application.Resources>
        <!-- pane colors per theme, used by PaneView -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="{x:Static local:ThemeManager.MidnightCommanderVariant}">
                    <SolidColorBrush x:Key="PaneBackground" Color="#0000AA" />
                    <SolidColorBrush x:Key="PaneBorder" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeaderForeground" Color="#FFFF55" />
                    <SolidColorBrush x:Key="ContainerForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ItemForeground" Color="#AAAAAA" />
                    <SolidColorBrush x:Key="ExecutableForeground" Color="#55FF55" />
                    <SolidColorBrush x:Key="PathForeground" Color="#FFFF55" />
                    <SolidColorBrush x:Key="ActivePathBackground" Color="#AAAAAA" />
                    <SolidColorBrush x:Key="ActivePathForeground" Color="#000000" />
                    <SolidColorBrush x:Key="SelectedEntryForeground" Color="#000000" />
                    <SolidColorBrush x:Key="MarkedEntryForeground" Color="#FFFF55" />
                    <SolidColorBrush x:Key="MarkedContainerBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MarkedItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="AdministratorBackground" Color="#C62828" />
                    <SolidColorBrush x:Key="AdministratorForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ViewerSelectionBackground" Color="#00AAAA" />
                    <SolidColorBrush x:Key="ViewerSelectionForeground" Color="#000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PaneBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PaneBorder" Color="#D0D0D0" />
                    <SolidColorBrush x:Key="HeaderForeground" Color="#606060" />
                    <SolidColorBrush x:Key="ContainerForeground" Color="#000000" />
                    <SolidColorBrush x:Key="ItemForeground" Color="#404040" />
                    <SolidColorBrush x:Key="ExecutableForeground" Color="#008000" />
                    <SolidColorBrush x:Key="PathForeground" Color="#404040" />
                    <SolidColorBrush x:Key="ActivePathBackground" Color="#0067C0" />
                    <SolidColorBrush x:Key="ActivePathForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SelectedEntryForeground" Color="#000000" />
                    <SolidColorBrush x:Key="MarkedEntryForeground" Color="#B07800" />
                    <SolidColorBrush x:Key="MarkedContainerBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MarkedItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="AdministratorBackground" Color="#C62828" />
                    <SolidColorBrush x:Key="AdministratorForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ViewerSelectionBackground" Color="#ADD6FF" />
                    <SolidColorBrush x:Key="ViewerSelectionForeground" Color="#000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PaneBackground" Color="#202020" />
                    <SolidColorBrush x:Key="PaneBorder" Color="#404040" />
                    <SolidColorBrush x:Key="HeaderForeground" Color="#A0A0A0" />
                    <SolidColorBrush x:Key="ContainerForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ItemForeground" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="ExecutableForeground" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="PathForeground" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="ActivePathBackground" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="ActivePathForeground" Color="#000000" />
                    <SolidColorBrush x:Key="SelectedEntryForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MarkedEntryForeground" Color="#FFD700" />
                    <SolidColorBrush x:Key="MarkedContainerBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MarkedItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="AdministratorBackground" Color="#C62828" />
                    <SolidColorBrush x:Key="AdministratorForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ViewerSelectionBackground" Color="#264F78" />
                    <SolidColorBrush x:Key="ViewerSelectionForeground" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- tabs of dialogs (settings, properties) drawn as tabs on a panel, like the TUI's: the selected tab is joined
                 to the panel showing its contents; used with TabControl.dialogTabs -->
            <ControlTheme x:Key="DialogTabItem" TargetType="TabItem">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                <Setter Property="BorderThickness" Value="1,1,1,0" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="Margin" Value="0,4,2,0" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4,4,0,0">
                            <DockPanel>
                                <!-- accent line on top of the selected tab -->
                                <Border Name="PART_Accent" DockPanel.Dock="Top" Height="2" CornerRadius="4,4,0,0"
                                        Background="{DynamicResource SystemAccentColor}" IsVisible="False" />
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  Padding="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                </Style>
                <!-- the selected tab and its panel have the dialog's background, so only the borders mark them -->
                <Style Selector="^:selected">
                    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <!-- covers the panel's top border below the tab -->
                    <Setter Property="Margin" Value="0,0,2,-1" />
                    <Setter Property="Padding" Value="14,8,14,7" />
                </Style>
                <Style Selector="^:selected /template/ Border#PART_Accent">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TabControl.dialogTabs /template/ ContentPresenter#PART_SelectedContentHost">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0,4,4,4" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <!-- the tabs are drawn over the panel, so the selected tab covers its border -->
        <Style Selector="TabControl.dialogTabs /template/ ItemsPresenter">
            <Setter Property="ZIndex" Value="1" />
        </Style>
    </Application.Styles>
</Application>

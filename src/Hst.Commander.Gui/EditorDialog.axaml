<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hst.Commander.Gui.EditorDialog"
        Title="Edit"
        Width="1000" Height="700"
        MinWidth="400" MinHeight="300"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="8,4" VerticalAlignment="Center" />
        <!-- function key bar like the viewer; the buttons aren't focusable so the text keeps the focus -->
        <UniformGrid DockPanel.Dock="Bottom" Rows="1">
            <UniformGrid.Styles>
                <Style Selector="Button.functionKey">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Margin" Value="1" />
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Style Selector="Button.functionKey TextBlock">
                    <Setter Property="Padding" Value="6,3" />
                </Style>
                <Style Selector="Button.functionKey TextBlock.key">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Padding" Value="6,3,0,3" />
                </Style>
            </UniformGrid.Styles>
            <Button x:Name="SaveButton" Classes="functionKey">
                <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="F2" /><TextBlock Text="Save" /></StackPanel>
            </Button>
            <Button x:Name="ReplaceButton" Classes="functionKey">
                <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="F4" /><TextBlock Text="Replace" /></StackPanel>
            </Button>
            <Button x:Name="NextButton" Classes="functionKey">
                <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="F5" /><TextBlock Text="Next" /></StackPanel>
            </Button>
            <Button x:Name="PreviousButton" Classes="functionKey">
                <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="F6" /><TextBlock Text="Previous" /></StackPanel>
            </Button>
            <Button x:Name="SearchButton" Classes="functionKey">
                <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="F7" /><TextBlock Text="Search" /></StackPanel>
            </Button>
            <Button x:Name="WrapButton" Classes="functionKey">
                <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="F8" /><TextBlock x:Name="WrapButtonText" Text="Wrap" /></StackPanel>
            </Button>
            <Button x:Name="CloseButton" Classes="functionKey">
                <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="F10" /><TextBlock Text="Close" /></StackPanel>
            </Button>
            <Button x:Name="GoToLineButton" Classes="functionKey">
                <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="Ctrl+G" /><TextBlock Text="Line" /></StackPanel>
            </Button>
        </UniformGrid>
        <Border BorderBrush="{DynamicResource PaneBorder}" BorderThickness="1">
            <TextBox x:Name="TextBox"
                     AcceptsReturn="True" AcceptsTab="True"
                     NewLine="&#10;"
                     BorderThickness="0" CornerRadius="0"
                     FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"
                     Background="{DynamicResource PaneBackground}"
                     Foreground="{DynamicResource ItemForeground}"
                     CaretBrush="{DynamicResource ItemForeground}"
                     SelectionBrush="{DynamicResource ViewerSelectionBackground}"
                     SelectionForegroundBrush="{DynamicResource ViewerSelectionForeground}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <TextBox.Styles>
                    <!-- keeps the theme's colors when hovered and focused instead of the fluent theme's -->
                    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                        <Setter Property="Background" Value="{DynamicResource PaneBackground}" />
                    </Style>
                    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                        <Setter Property="Background" Value="{DynamicResource PaneBackground}" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                    <Style Selector="TextBox:pointerover">
                        <Setter Property="Foreground" Value="{DynamicResource ItemForeground}" />
                    </Style>
                    <Style Selector="TextBox:focus">
                        <Setter Property="Foreground" Value="{DynamicResource ItemForeground}" />
                    </Style>
                </TextBox.Styles>
            </TextBox>
        </Border>
    </DockPanel>
</Window>

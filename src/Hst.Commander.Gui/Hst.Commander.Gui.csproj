<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>..\icon\hst-commander.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia" Version="12.1.4" />
      <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
      <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaResource Include="..\icon\hst-commander.ico" Link="Assets\hst-commander.ico" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Hst.Commander.Core\Hst.Commander.Core.csproj" />
      <ProjectReference Include="..\Hst.Commander.Extensions.Volume.Abstractions\Hst.Commander.Extensions.Volume.Abstractions.csproj" />
    </ItemGroup>

</Project>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hst.Commander.Gui.BackgroundPicker">
    <!-- background of an image preview: a palette of common colors and a custom color -->
    <Button x:Name="BackgroundButton" ToolTip.Tip="Background color of the preview">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Border x:Name="BackgroundSwatch" Width="20" Height="14" BorderBrush="Gray" BorderThickness="1" />
            <TextBlock x:Name="BackgroundText" VerticalAlignment="Center" />
        </StackPanel>
        <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedLeft">
                <StackPanel Spacing="8" Width="240">
                    <!-- swatches of the common colors are added by the code-behind -->
                    <StackPanel x:Name="SwatchesPanel" />
                    <Separator />
                    <TextBlock Text="Custom" FontWeight="Bold" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                        <TextBlock Grid.Row="0" Text="Red:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <NumericUpDown x:Name="RedUpDown" Grid.Row="0" Grid.Column="1" Minimum="0"
                                       Maximum="255" Increment="1" FormatString="0" />
                        <TextBlock Grid.Row="1" Text="Green:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <NumericUpDown x:Name="GreenUpDown" Grid.Row="1" Grid.Column="1" Minimum="0"
                                       Maximum="255" Increment="1" FormatString="0" />
                        <TextBlock Grid.Row="2" Text="Blue:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <NumericUpDown x:Name="BlueUpDown" Grid.Row="2" Grid.Column="1" Minimum="0"
                                       Maximum="255" Increment="1" FormatString="0" />
                        <TextBlock Grid.Row="3" Text="Hex:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="HexTextBox" Grid.Row="3" Grid.Column="1" PlaceholderText="#RRGGBB" />
                    </Grid>
                    <DockPanel>
                        <Button x:Name="ApplyCustomButton" DockPanel.Dock="Right" Content="Apply" MinWidth="80"
                                HorizontalContentAlignment="Center" />
                        <Border x:Name="CustomSwatch" Width="40" Height="24" BorderBrush="Gray"
                                BorderThickness="1" HorizontalAlignment="Left" />
                    </DockPanel>
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>

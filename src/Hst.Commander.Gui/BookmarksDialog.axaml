<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Hst.Commander.Core"
        x:Class="Hst.Commander.Gui.BookmarksDialog"
        Title="Bookmarks"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <StackPanel Margin="16" Spacing="8">
        <ListBox x:Name="BookmarksList" MaxHeight="400">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:VolumeChoice">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                <Button x:Name="RenameButton" Content="_Rename..." MinWidth="80" HorizontalContentAlignment="Center"
                        ToolTip.Tip="Change the description of the bookmark (F2)" />
                <Button x:Name="DeleteButton" Content="_Delete" MinWidth="80" HorizontalContentAlignment="Center"
                        ToolTip.Tip="Delete the bookmark (Del)" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="OkButton" Content="OK" MinWidth="80" HorizontalContentAlignment="Center"
                        IsDefault="True" />
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="80" HorizontalContentAlignment="Center"
                        IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:Hst.Commander.Gui.Icons"
        xmlns:local="using:Hst.Commander.Gui"
        x:Class="Hst.Commander.Gui.IconViewerDialog"
        Title="Icon"
        Width="800" Height="600"
        MinWidth="320" MinHeight="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="OkButton" DockPanel.Dock="Right" Content="OK" MinWidth="80"
                    HorizontalContentAlignment="Center" IsDefault="True" IsCancel="True" />
            <TextBlock DockPanel.Dock="Left" Text="Zoom:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="ZoomComboBox" DockPanel.Dock="Left" MinWidth="100" />
            <TextBlock DockPanel.Dock="Left" Text="Background:" VerticalAlignment="Center" Margin="16,0,8,0" />
            <local:BackgroundPicker x:Name="BackgroundPicker" DockPanel.Dock="Left" />
        </DockPanel>
        <!-- the icons of the file, shown when it has more than one -->
        <ListBox x:Name="IconsList" DockPanel.Dock="Left" Width="200" Margin="0,0,12,0" IsVisible="False"
                 SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="icons:ViewerIcon">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,8,0"
                               Source="{Binding Thumbnail}" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- the images of the selected icon, e.g. sizes and color depths of a Windows icon -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Image:" VerticalAlignment="Center" />
            <ComboBox x:Name="ImagesComboBox" MinWidth="160" />
            <TextBlock x:Name="ImagesText" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>
        <!-- the checkerboard background shows the transparent parts of the icon -->
        <Border x:Name="ImageBorder" BorderBrush="Gray" BorderThickness="1">
            <ScrollViewer x:Name="ImageScrollViewer">
                <Image x:Name="IconImage" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>

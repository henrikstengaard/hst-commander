            },
            "marked-cursor-foreground": {
              "$ref": "#/$defs/color"
            },
            "menu-focus-background": {
              "$ref": "#/$defs/color"
            },
            "menu-focus-foreground": {
              "$ref": "#/$defs/color"
            },
            "menu-hot-foreground": {
              "$ref": "#/$defs/color"
            },
            "key-background": {
              "$ref": "#/$defs/color"
            },
            "key-foreground": {
